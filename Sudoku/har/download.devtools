            "text": "@charset \"UTF-8\";.pinpoint__container{--launch-footer-background:var(\n    --Pinpoint-Start-Screen-Gradient,\n    linear-gradient(180deg, #0c6fe9 0%, #014292 100%)\n  );--pinpoint-shimmer-color:rgba(255, 255, 255, 0.3);--pinpoint-aha-margin-bottom:clamp(2.5rem, 8vh, 8rem);--pinpoint-aha-rise-height:clamp(6.5rem, 12vh, 32.75rem)}.pinpoint__container.hue-web-color-scheme--dark{--launch-footer-background:var(\n    --Pinpoint-Start-Screen-Gradient,\n    linear-gradient(180deg, #0157d0 0%, #012a7a 100%)\n  )}.pinpoint__container.full-screen-container--mobile-webview{--pinpoint-aha-margin-bottom:clamp(7.25rem, 23vh, 21rem);--pinpoint-aha-rise-height:clamp(13.25rem, 47vh, 49rem)}@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(8px)}75%{transform:translateX(-8px)}}@keyframes cardShimmer{0%{left:-70%}100%{left:75%}}.pinpoint__form{opacity:1;transform:translateY(0);transition:opacity .2s ease-out,transform .2s ease-out}.pinpoint__form.pinpoint__form--dismissing{opacity:0;transform:translateY(8px)}.pinpoint__form .pinpoint__input-wrapper{position:relative;border-top:1px solid var(--pinpoint-answers-border);display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background-color:var(--pinpoint-answers-background)}.pinpoint__form .pinpoint__input{padding-left:0;background:0;border:0;box-shadow:none;outline:0;font-size:16px;color:var(--hue-web-color-text);font-style:normal;line-height:125%}.pinpoint__form .pinpoint__input::placeholder{color:var(--hue-web-color-text)}.hue-web-color-scheme--dark .pinpoint__submit-btn.artdeco-button--muted.artdeco-button--tertiary,.pinpoint__form .pinpoint__count{color:var(--hue-web-color-text-secondary)}.pinpoint__form .pinpoint__input:active,.pinpoint__form .pinpoint__input:focus,.pinpoint__form .pinpoint__input:hover{box-shadow:none;outline:0;background-color:initial}.pinpoint__form .pinpoint__input[type=text]:disabled{background-color:initial}.pinpoint__form .pinpoint__count
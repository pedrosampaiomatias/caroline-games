iewingBehavior\":\"DEFAULT\",\"trackingActionType\":\"viewAttributedCompany\",\"accessibilityText\":\"View company: Mini Sudoku, a puzzle by LinkedIn\",\"sponsoredUrlAttributes\":null,\"$recipeTypes\":[\"com.linkedin.59ffb70d1709d8b7b1d4b991ba8272fc\"],\"$type\":\"com.linkedin.voyager.dash.feed.navigation.FeedNavigationContext\"},\"ringStatus\":null,\"groupMembershipForJoinAction\":null,\"showSmallActorPortrait\":false},\"boostHeader\":null,\"*socialDetail\":\"urn:li:fsd_socialDetail:(urn:li:ugcPost:7520741452520333312,urn:li:ugcPost:7520741452520333312,urn:li:highlightedReply:-)\",\"header\":null,\"highlightedComments\":[],\"preDashEntityUrn\":\"urn:li:fs_updateV2:(urn:li:activity:7520741456517664768,COMPANY_FEED,DEBUG_REASON,DEFAULT,false)\",\"commentary\":{\"numLines\":3,\"translation\":null,\"navigationContext\":null,\"metadataText\":null,\"text\":{\"textDirection\":\"FIRST_STRONG\",\"text\":\"Mini Sudoku No. 442, 'Offsets II' with Thomas Snyder is now live: lnkd.in/minisudoku. Watch as the 3x World Sudoku Champion walks through today’s puzzle from start to finish. (Spoiler alert if you haven’t played yet!)\\n\\nMini Sudoku is a bite-sized take on the classic logic game where each row, column, and shaded region must contain every digit exactly once.\\n\\nNew editions drop daily, and you can turn on notifications, so you never miss one.\\n\\nComments should follow our Professional Community Policies. Content that may be spam or unprofessional may be removed.\\n#MiniSudoku #LinkedInGames\",\"attributesV2\":[{\"start\":39,\"length\":13,\"detailData\":{\"jobPostingName\":null,\"hyperlink\":null,\"profileFamiliarName\":null,\"color\":null,\"companyName\":null,\"icon\":null,\"epoch\":null,\"systemImage\":null,\"textLink\":null,\"listItemStyle\":null,\"groupName\":null,\"hyperlinkOpenExternally\":null,\"listStyle\":null,\"*profileMention\":\"urn:li:fsd_profile:ACoAAADziwoB116kjTOvYSb3owL-QHELEYpdRRE\",\"profileFullName\":null,\"stringFieldReference\":null,\"learningCou